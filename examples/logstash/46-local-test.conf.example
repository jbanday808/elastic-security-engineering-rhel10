# Example only: local JSON pipeline; does not forward to Elasticsearch.
input {
  tcp {
    id => "rhel10_tcp_input"
    host => "127.0.0.1"
    port => 5055
    codec => json
  }
}
filter {
  mutate {
    add_field => { "[event][dataset]" => "logstash.lab" }
  }
}
output {
  file {
    id => "rhel10_file_output"
    path => "/var/lib/logstash/lab/events.jsonl"
    codec => json_lines
    file_mode => 0640
  }
}
